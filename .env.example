# Copy to .env and fill in. Never commit .env or .env.local.

# --- required ---
INKBOX_API_KEY=            # admin-scoped key from https://inkbox.ai/console
OPENAI_API_KEY=            # reply reading + the realtime call voice (gpt-realtime-2.1)
MILO_HANDLE=hey-milo       # Inkbox handle for Milo (must be globally unique)

# --- written by the setup scripts into .env.local ---
# INKBOX_KEY_<HANDLE>=     # one agent-scoped key per identity (scripts/setup.ts)
# INKBOX_WEBHOOK_SECRET=   # webhook signing key (scripts/configure.ts)

# --- Slack (scripts/slack.ts) ---
SLACK_CONFIGURATION_ACCESS_TOKEN=   # api.slack.com/apps -> Your App Configuration Tokens
SLACK_CONFIGURATION_REFRESH_TOKEN=

# --- optional ---
MILO_UNAVAILABLE=          # comma-separated people Milo must not call, e.g. daniel
MILO_FIRST_CONTACT=ben     # first person Milo reaches
MILO_CALL_ENGINE=bridge    # bridge (own conference, guests heard) | hosted (Inkbox Voice AI)
MILO_GUESTS=1              # hosted engine only: 0 = call the named person separately
MILO_LISTEN_AFTER_MS=1200000   # keep listening this long after no answer
MILO_MODEL=gpt-5.4-mini    # reads replies and transcripts
MILO_RT_MODEL=gpt-realtime-2.1
MILO_RT_VOICE=cedar
MILO_TRANSCRIPT_BASE=https://milo-calls.vercel.app/t
MILO_T_SLACK=20000         # demo timeouts (ms)
MILO_T_IMESSAGE=15000
MILO_T_OWNER_AGENT=12000
MILO_T_CALL=360000
MILO_MCP_WAIT_MS=240000
PORT=8787

# --- x402 payments (paid_fetch) ---
X402_PRIVATE_KEY=          # wallet that pays (0x…); use a Base Sepolia testnet key. Unset = throwaway unfunded wallet
MILO_PAY_MAX_USD=1         # hard cap per payment, even with a human's OK
MILO_DEMO_X402_NETWORK=eip155:84532   # local demo endpoint: network (Base Sepolia)
MILO_DEMO_X402_PAY_TO=     # local demo endpoint: recipient address
